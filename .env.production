# Shared secret
INTERNAL_SERVICE_KEY=refinery-local-key

# Ports (optional for local isolated dev:prod runs)
# DO NOT ADD THESE PORTS TO RENDER OR OTHER PRODUCTION ENVIRONMENTS
API_GATEWAY_PORT=8000
EVENT_BUS_PORT=8001
CATALOG_PORT=8002
PURCHASE_ORDERS_PORT=8003

# Per-service databases
EVENT_BUS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
CATALOG_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
PURCHASE_ORDERS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Service routing
SERVICE_EVENT_BUS_URL=https://event-bus.your-domain.com
SERVICE_CATALOG_URL=https://catalog.your-domain.com
SERVICE_PURCHASE_ORDERS_URL=https://purchase-orders.your-domain.com
